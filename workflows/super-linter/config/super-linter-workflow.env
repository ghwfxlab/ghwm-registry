# Settings for the workflow itself (not passed to Super-Linter). The workflow loads this file.
# true: on pull requests, fail when a changed file needs a linter that super-linter.env does not enable.
# Only useful with a lean image. Leave false if you skip some file types on purpose.
RUN_SUPER_LINTER_CUSTOM_DRIFT_CHECK=false
# Custom image: a Super-Linter image to run instead of the upstream one. It may be a lean image.
# host/path:tag or host/path@sha256:digest. Empty runs the upstream image chosen by RUN_SUPER_LINTER_SLIM.
SUPER_LINTER_CUSTOM_IMAGE=
