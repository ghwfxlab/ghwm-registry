---
import Layout from '../layouts/Layout.astro';
import ExploreSearch from '../components/ExploreSearch.astro';
import GetStarted from '../components/GetStarted.astro';
import TrendingWorkflows from '../components/TrendingWorkflows.astro';
import NewArrivals from '../components/NewArrivals.astro';
---

<Layout title="GHWM Marketplace - Manage GitHub Workflows" activeTab="explore">
  <!-- Main Content Canvas -->
  <main class="flex-grow w-full max-w-7xl mx-auto px-margin md:px-lg py-2xl flex flex-col gap-2xl">

    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center py-xl gap-lg w-full">
      <h1 class="font-display-lg text-display-lg max-w-3xl leading-tight">
        Manage your GitHub Workflows as Packages
      </h1>
      <p class="font-body-lg text-body-lg max-w-4/5 text-on-surface-variant">
        Install, update, and audit managed workflow files from a central marketplace.
      </p>

      <!-- Explore Search Component -->
      <ExploreSearch />

      <!-- Get Started & Installation Component -->
      <GetStarted />
    </section>

    <!-- Trending Workflows Component -->
    <TrendingWorkflows />

    <!-- New Arrivals Component -->
    <NewArrivals />

  </main>
</Layout>
