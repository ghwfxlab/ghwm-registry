---
import Layout from '../layouts/Layout.astro';

// Installation commands from pljanicki/ghwm README
const installCommands = {
  'uv': 'uv tool install git+https://github.com/pljanicki/ghwm.git',
  'uv-pinned': 'uv tool install git+https://github.com/pljanicki/ghwm.git@v1.0.0',
  'pipx': 'pipx install git+https://github.com/pljanicki/ghwm.git',
  'pip': 'pip install git+https://github.com/pljanicki/ghwm.git'
};

// Placeholder count for New Arrivals skeleton loaders
const skeletonCount = Array.from({ length: 5 });
---

<Layout title="GHWM Marketplace - Manage GitHub Workflows" activeTab="explore">
  <!-- Main Content Canvas -->
  <main class="flex-grow w-full max-w-7xl mx-auto px-margin md:px-lg py-2xl flex flex-col gap-2xl">

    <!-- Hero Section -->
    <section class="flex flex-col items-center text-center py-xl gap-lg w-full">
      <h1 class="font-display-lg text-display-lg max-w-3xl leading-tight">
        Manage your GitHub Workflows as Packages
      </h1>
      <p class="font-body-lg text-body-lg max-w-4/5 text-on-surface-variant">
        Install, update, and audit managed workflow files from a central marketplace.
      </p>

      <!-- Prominent Search in Hero -->
      <div class="w-full max-w-4/5 mt-md">
        <div class="flex items-center card-surface rounded-default px-md py-sm shadow-sm input-focus w-full">
          <span class="material-symbols-outlined text-outline mr-sm">search</span>
          <input
            class="bg-transparent border-none outline-none text-body-lg font-body-lg text-on-surface w-full focus:ring-0 p-0 placeholder-outline"
            placeholder="Search linter, ci/cd, deployment..."
            type="text"
          />
          <button class="ml-auto font-label-caps text-label-caps bg-surface-container-high px-sm py-xs rounded border border-outline-variant text-outline">
            ↵ ENTER
          </button>
        </div>
      </div>

      <!-- Quick Action Buttons & Interactive Clipboard / Selector -->
      <div class="flex flex-col md:flex-row gap-lg items-center justify-center mt-lg w-full px-md md:px-0 mx-auto">
        <!-- Get Started (Horizontal element 1) -->
        <button class="btn-primary font-headline-md text-headline-md px-lg py-md rounded-default shadow-sm flex items-center gap-sm transition-transform active:scale-95 cursor-pointer h-[48px] shrink-0 w-[240px] md:w-auto justify-center">
          Get Started
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </button>

        <!-- Vertical Container (Horizontal element 2) -->
        <div class="flex flex-col gap-sm w-full max-w-[420px] md:w-[420px] shrink-0">
          <!-- Button Group Wrapper (Relative to hold badge) -->
          <div class="relative w-full mt-4">
            <!-- Small Recommended badge above "uv (pinned)" button -->
            <div class="absolute -top-5 left-2 font-mono uppercase font-bold tracking-wider text-[9px] text-primary select-none px-1.5">
              ★ RECOMMENDED
            </div>

            <!-- Button Group (Top) - Parent holds common styles for clean simplicity -->
            <div class="flex items-center w-full border border-outline-variant rounded-default bg-surface [&_button]:flex-1 [&_button]:py-2 [&_button]:font-mono [&_button]:text-xs [&_button]:hover:bg-surface-container [&_button]:transition-all [&_button]:cursor-pointer [&_button]:whitespace-nowrap [&_button]:text-center [&_button]:border-r [&_button]:border-outline-variant [&_button:last-child]:border-r-0 [&_button:first-child]:rounded-l-default [&_button:last-child]:rounded-r-default h-[36px] overflow-hidden" id="method-button-group">
              <button
                data-method="uv-pinned"
                class="method-btn bg-surface-container-low text-primary font-bold"
              >
                uv (pinned)
              </button>
              <button
                data-method="uv"
                class="method-btn text-on-surface-variant"
              >
                uv
              </button>
              <button
                data-method="pipx"
                class="method-btn text-on-surface-variant"
              >
                pipx
              </button>
              <button
                data-method="pip"
                class="method-btn text-on-surface-variant"
              >
                pip
              </button>
            </div>
          </div>

          <!-- Interactive Clipboard Box (Bottom) - Flex align & Wordwrap to avoid overlap -->
          <div class="w-full terminal-bg border border-outline-variant rounded-default px-sm py-2 flex items-center justify-between shadow-sm min-h-[42px] gap-sm group">
            <div class="flex-1 text-left pr-2 flex items-center">
              <code id="install-command" class="font-code-md text-code-md text-secondary select-all whitespace-normal break-all">
                {installCommands['uv-pinned']}
              </code>
            </div>

            <button
              id="copy-command-btn"
              aria-label="Copy install command"
              class="text-outline hover:text-on-surface transition-colors cursor-pointer rounded bg-[#010409] flex items-center justify-center h-[32px] w-[56px] shrink-0"
            >
              <span id="copy-icon" class="material-symbols-outlined text-[16px] select-none">content_copy</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Trending Workflows Section (10 items, 5 per row max on desktop, 2 per row on mobile) -->
    <section class="flex flex-col gap-md">
      <div class="flex justify-between items-end border-b border-outline-variant pb-sm mb-xs">
        <h2 class="font-headline-lg text-headline-lg flex items-center gap-sm">
          <span class="material-symbols-outlined text-tertiary">local_fire_department</span>
          Trending Workflows
        </h2>
        <a class="font-body-sm text-body-sm text-primary hover:underline" href="#">View all &rarr;</a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-gutter">
        <!-- Card 1: Real Content with Lorem Ipsum -->
        <div class="card-surface rounded-lg p-md flex flex-col gap-sm transition-all group cursor-pointer h-full">
          <div class="flex justify-between items-start gap-xs">
            <div class="w-8 h-8 bg-surface-container-high border border-outline-variant rounded flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-primary text-[18px]">fact_check</span>
            </div>
            <div class="font-code-sm text-code-sm bg-surface-container-low text-secondary border border-secondary border-opacity-35 px-1.5 py-0.5 rounded flex items-center gap-0.5 shrink-0 scale-90">
              <span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">verified</span>
              98
            </div>
          </div>

          <div class="mt-xs">
            <h3 class="font-headline-md text-[14px] leading-[20px] font-semibold group-hover:text-primary transition-colors line-clamp-1">
              Universal Monorepo Linter
            </h3>
            <p class="font-body-sm text-[12px] leading-[16px] text-on-surface-variant line-clamp-1 mt-0.5 mb-1.5">
              ghwm/core-linter
            </p>
            <p class="font-body-sm text-[11px] leading-[15px] text-on-surface-variant mt-1.5 opacity-80 line-clamp-3">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
            </p>
          </div>

          <div class="flex gap-xs mt-auto pt-sm flex-wrap">
            <span class="font-code-sm text-[10px] leading-[14px] border border-outline-variant px-1.5 py-0.5 rounded text-outline bg-surface-container-lowest">
              lint
            </span>
            <span class="font-code-sm text-[10px] leading-[14px] border border-outline-variant px-1.5 py-0.5 rounded text-outline bg-surface-container-lowest">
              typescript
            </span>
            <span class="font-code-sm text-[10px] leading-[14px] border border-outline-variant px-1.5 py-0.5 rounded text-outline bg-surface-container-lowest">
              monorepo
            </span>
          </div>
        </div>

        <!-- Cards 2-10: Skeletons -->
        {Array.from({ length: 9 }).map(() => (
          <div class="card-surface rounded-lg p-md flex flex-col gap-sm animate-pulse border border-outline-variant border-opacity-40">
            <!-- Icon and Score Skeletons -->
            <div class="flex justify-between items-start gap-xs">
              <div class="w-8 h-8 bg-surface-container-highest border border-outline-variant border-opacity-30 rounded shrink-0"></div>
              <div class="w-10 h-5 bg-surface-container-highest rounded-default shrink-0"></div>
            </div>

            <!-- Headline and Subtitle Skeletons -->
            <div class="mt-xs space-y-2">
              <div class="h-4 bg-surface-container-highest rounded-default w-3/4"></div>
              <div class="h-3 bg-surface-container-high rounded-default w-1/2"></div>

              <!-- Paragraph Loader mimicking Lorem Ipsum description lines -->
              <div class="space-y-1.5 pt-1.5">
                <div class="h-2 bg-surface-container-high rounded-default w-full"></div>
                <div class="h-2 bg-surface-container-high rounded-default w-11/12"></div>
                <div class="h-2 bg-surface-container-high rounded-default w-4/5"></div>
              </div>
            </div>

            <!-- Tags Skeletons -->
            <div class="flex gap-xs mt-auto pt-sm flex-wrap">
              <div class="h-4 bg-surface-container-high rounded-default w-8"></div>
              <div class="h-4 bg-surface-container-high rounded-default w-12"></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- New Arrivals Section (With high-fidelity skeleton placeholders based on Material Tailwind) -->
    <section class="flex flex-col gap-md">
      <div class="flex justify-between items-end border-b border-outline-variant pb-sm mb-xs">
        <h2 class="font-headline-lg text-headline-lg flex items-center gap-sm">
          <span class="material-symbols-outlined text-primary">new_releases</span>
          New Arrivals
        </h2>
        <span class="font-code-sm text-code-sm text-on-surface-variant">Live registry updates</span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-gutter">
        {skeletonCount.map(() => (
          <div class="card-surface rounded-lg p-md flex flex-col gap-sm animate-pulse border border-outline-variant border-opacity-40">
            <!-- Icon and Score Skeletons -->
            <div class="flex justify-between items-start gap-xs">
              <div class="w-8 h-8 bg-surface-container-highest border border-outline-variant border-opacity-30 rounded shrink-0"></div>
              <div class="w-10 h-5 bg-surface-container-highest rounded-default shrink-0"></div>
            </div>

            <!-- Headline and Subtitle Skeletons -->
            <div class="mt-xs space-y-2">
              <div class="h-4 bg-surface-container-highest rounded-default w-3/4"></div>
              <div class="h-3 bg-surface-container-high rounded-default w-1/2"></div>
            </div>

            <!-- Tags Skeletons -->
            <div class="flex gap-xs mt-auto pt-sm flex-wrap">
              <div class="h-4 bg-surface-container-high rounded-default w-8"></div>
              <div class="h-4 bg-surface-container-high rounded-default w-12"></div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <script define:vars={{ installCommands }}>
    // Select selectors
    const buttons = document.querySelectorAll('.method-btn');
    const codeDisplay = document.getElementById('install-command');

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const method = button.getAttribute('data-method');
        if (method && codeDisplay) {
          // Update code snippet content using the dynamically bound frontmatter variable
          codeDisplay.textContent = installCommands[method];

          // Revert active states on buttons
          buttons.forEach(btn => {
            btn.classList.remove('bg-surface-container-low', 'text-primary', 'font-bold');
            btn.classList.add('bg-surface', 'text-on-surface-variant');
          });

          // Apply active state on clicked button
          button.classList.remove('bg-surface', 'text-on-surface-variant');
          button.classList.add('bg-surface-container-low', 'text-primary', 'font-bold');
        }
      });
    });

    // Material Tailwind interactive Clipboard logic
    const copyBtn = document.getElementById('copy-command-btn');
    const copyIcon = document.getElementById('copy-icon');

    if (copyBtn && copyIcon && codeDisplay) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = codeDisplay.textContent.trim();
        try {
          await navigator.clipboard.writeText(textToCopy);

          // Switch to checkmark state
          copyIcon.textContent = 'check';
          copyIcon.classList.remove('text-outline');
          copyIcon.classList.add('text-secondary');

          // Revert icon and style after 2s
          setTimeout(() => {
            copyIcon.textContent = 'content_copy';
            copyIcon.classList.remove('text-secondary');
            copyIcon.classList.add('text-outline');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy CLI command: ', err);
        }
      });
    }
  </script>
</Layout>
