---
import { getTrendingWorkflows, getApiEndpoint, formatLastInstalled } from '../lib/usage';
import { withBase } from '../lib/paths';

const apiEndpoint = getApiEndpoint();
const { workflows } = await getTrendingWorkflows(apiEndpoint);
// Top up to 10 featured workflows (ordered by installs, but counts are not shown on the homepage)
const featuredWorkflows = workflows.slice(0, 10);
---
<!-- Featured Workflows Section (10 items, 5 per row max on desktop, 2 per row on mobile) -->
<section class="flex flex-col gap-md">
  <div class="flex justify-between items-end border-b border-outline-variant pb-sm mb-xs">
    <h2 class="font-headline-lg text-headline-lg flex items-center gap-sm">
      <span class="material-symbols-outlined text-tertiary">star</span>
      Featured Workflows
    </h2>
    <div class="flex items-center gap-md">
      <a class="font-body-sm text-body-sm text-primary hover:underline" href={withBase('/registry')}>View all &rarr;</a>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-5 gap-gutter" id="featured-workflows-grid">
    {featuredWorkflows.map((workflow) => {
      const lastActive = formatLastInstalled(workflow.lastInstalledAt);
      return (
        <a
          href={withBase(`/workflows/${workflow.name}`)}
          class="card-surface rounded-lg p-md flex flex-col gap-sm transition-all group cursor-pointer h-full hover:border-primary block"
          data-workflow-name={workflow.name}
        >
          <div class="flex justify-between items-start gap-xs">
            <div class="w-8 h-8 bg-surface-container-high border border-outline-variant rounded flex items-center justify-center shrink-0 group-hover:border-primary transition-colors">
              <span class="material-symbols-outlined text-primary text-[18px]">{workflow.icon}</span>
            </div>
          </div>

          <div class="mt-xs">
            <h3 class="font-headline-md text-[14px] leading-[20px] font-semibold group-hover:text-primary transition-colors line-clamp-1">
              {workflow.title}
            </h3>
            <p class="font-body-sm text-[12px] leading-[16px] text-on-surface-variant line-clamp-1 mt-0.5 mb-1">
              {workflow.packageName}
            </p>
            {lastActive && (
              <p class="font-code-sm text-[10px] text-on-surface-variant opacity-60 mb-1">
                Active {lastActive}
              </p>
            )}
            <p class="font-body-sm text-[11px] leading-[15px] text-on-surface-variant mt-1 opacity-80 line-clamp-3">
              {workflow.description}
            </p>
          </div>

          <div class="flex gap-xs mt-auto pt-sm flex-wrap items-center justify-between">
            <div class="flex gap-xs flex-wrap">
              {workflow.tags.map((tag) => (
                <span class="font-code-sm text-[10px] leading-[14px] border border-outline-variant px-1.5 py-0.5 rounded text-outline bg-surface-container-lowest">
                  {tag}
                </span>
              ))}
            </div>
            <span class="font-code-sm text-[10px] text-primary opacity-0 group-hover:opacity-100 transition-opacity">
              &rarr;
            </span>
          </div>
        </a>
      );
    })}

    {featuredWorkflows.length === 0 && (
      <div class="col-span-2 md:col-span-5 card-surface rounded-lg p-xl border border-outline-variant text-center">
        <p class="font-body-sm text-body-sm text-on-surface-variant">No featured workflows found.</p>
      </div>
    )}
  </div>
</section>
