---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface border-t border-outline-variant mt-2xl w-full">
  <div class="max-w-7xl mx-auto px-lg py-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
    <!-- Left Logo and Green Copyright -->
    <div class="flex flex-col">
      <div class="font-code-sm text-code-sm text-secondary mt-1">
        &copy; {currentYear} GHWM Registry. Built for the open source community.
      </div>
    </div>

    <!-- Right Navigation Links -->
    <div class="flex flex-wrap gap-md md:gap-lg font-code-sm text-code-sm text-on-surface-variant">
      <a href="https://github.com/ghwfxlab/ghwm" class="hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Documentation</a>
      <a href="https://github.com/ghwfxlab/ghwm#telemetry--privacy" class="hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">Privacy</a>
    </div>
  </div>
</footer>
