---
const currentYear = new Date().getFullYear();
---

<footer class="bg-surface border-t border-outline-variant mt-2xl w-full">
  <div class="max-w-7xl mx-auto px-lg py-lg flex flex-col md:flex-row justify-between items-start md:items-center gap-md">
    <!-- Left Logo and Green Copyright -->
    <div class="flex flex-col">
      <div class="font-label-caps text-label-caps text-on-surface font-bold tracking-wider">GHWM</div>
      <div class="font-code-sm text-code-sm text-secondary mt-1">
        &copy; {currentYear} GHWM Marketplace. Built for the open source community.
      </div>
    </div>

    <!-- Right Navigation Links -->
    <div class="flex flex-wrap gap-md md:gap-lg font-code-sm text-code-sm text-on-surface-variant">
      <a href="https://github.com" class="hover:text-primary transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/docs" class="hover:text-primary transition-colors">Documentation</a>
      <a href="/security" class="hover:text-primary transition-colors">Security</a>
      <a href="/terms" class="hover:text-primary transition-colors">Terms</a>
    </div>
  </div>
</footer>
