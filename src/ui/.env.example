# GHWM Registry UI Environment Configuration
#
# Target API endpoint for fetching workflow usage / telemetry statistics.
# Point to the Cloudflare Worker deployment:
#
# Production API Endpoint (default for production builds):
PUBLIC_API_URL=https://ghwm-deployment-prd.ghwfxlab.workers.dev
#
# Test API Endpoint (for local/testing development):
# PUBLIC_API_URL=https://ghwm-deployment-tst.ghwfxlab.workers.dev
#
# GitHub Pages Routing (optional overrides):
# ASTRO_SITE=https://ghwfxlab.github.io
# ASTRO_BASE=/ghwm
